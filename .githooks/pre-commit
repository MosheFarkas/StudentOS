#!/bin/sh
#
# Refuse a commit CI would reject on its first step.
#
# CI runs `prettier --check .` before anything else, so an unformatted file
# fails the run in seconds and every later step -- lint, typecheck, tests,
# build -- never runs at all. That is a slow way to find out, and a whole
# session's worth of pushes went red this way before anyone looked.
#
# Only staged files are checked, deliberately. Being blocked by a scratch file
# sitting unstaged in the working tree teaches people to pass --no-verify,
# and a hook that gets bypassed is worse than no hook.

staged=$(git diff --cached --name-only --diff-filter=ACM |
  grep -Ei '\.(ts|tsx|js|jsx|mjs|cjs|json|md|css|html|ya?ml)$' || true)

[ -z "$staged" ] && exit 0

# NUL-delimited: filenames in this repo contain spaces.
if ! git diff --cached --name-only --diff-filter=ACM -z |
  grep -zEi '\.(ts|tsx|js|jsx|mjs|cjs|json|md|css|html|ya?ml)$' |
  xargs -0 npx prettier --check --ignore-unknown 2>&1; then
  echo ""
  echo "Formatting would fail CI. Run:  pnpm format"
  echo "Then stage the changes and commit again."
  exit 1
fi
