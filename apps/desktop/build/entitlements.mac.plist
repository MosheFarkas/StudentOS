<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      The hardened runtime is required for notarization, and it blocks things
      Electron needs by default. These four are what V8 requires: it compiles
      JavaScript to machine code at runtime, which is exactly the behaviour
      the hardened runtime exists to prevent.

      Nothing here grants access to the student's files, camera, or network
      beyond what any app has. This app's actual reach comes from the Chrome
      it drives, which is a separate signed application with its own sandbox.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
